# Database — PostgreSQL connection string
# Vercel Postgres uses POSTGRES_URL; set DATABASE_URL for local dev
POSTGRES_URL=postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/database

# Payload secret — used for encrypting tokens and hashing
PAYLOAD_SECRET=your-secret-here-change-in-production

# Vercel Blob Storage — for media uploads (assets.transformidablethinking.com)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Base URL for the CMS. This must be the origin the admin is actually browsed
# at — it seeds the CSRF allowlist, and an origin missing from that list makes
# the admin fail silently (array rows spin forever, logout doesn't log you out)
# while pages still render normally.
NEXT_PUBLIC_SERVER_URL=https://cms.transformidablethinking.com

# Optional — extra comma-separated origins allowed to carry the admin session
# cookie, on top of NEXT_PUBLIC_SERVER_URL and the Vercel deployment URLs.
# Use this to add an admin domain without a code change.
# PAYLOAD_CSRF_ORIGINS=https://cms.example.com,https://admin.example.com

# Public site base URL used to build case-file links and unsubscribe links
# in digest emails. Falls back to NEXT_PUBLIC_SERVER_URL if unset.
NEXT_PUBLIC_SITE_URL=https://transformidablethinking.com

# SMTP (Proton) — sends the daily case-follow digest email. Digest sending
# is a no-op locally if these are unset. If SMTP_HOST is a Proton Mail
# Bridge instance, it must be reachable from wherever this app runs.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-proton-address@proton.me
SMTP_PASS=your-proton-smtp-password
EMAIL_FROM=hello@transformidablethinking.com

# Optional — where contact form notification emails are sent. Falls back to
# EMAIL_FROM, then hello@transformidablethinking.com, if unset.
CONTACT_NOTIFY_EMAIL=hello@transformidablethinking.com

# Shared secret checked against the Authorization header on the digest cron
# route (api/cron/case-digest), since Vercel Cron requests aren't otherwise
# authenticated.
CRON_SECRET=your-cron-secret
