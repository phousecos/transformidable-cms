// The combined Transformidable + J. Lynne instance, in the J. Lynne Cloudflare
// account. It deploys as the existing `jlynne-cms` Worker, replacing the old
// J. Lynne library code there (its D1 and R2 stay, bound below for the
// import). Same code as wrangler.jsonc (the Transformidable account), which
// stays as it is until transformidablethinking.com moves over.
//
// Build:  npx opennextjs-cloudflare build --config wrangler.jlynne.jsonc
// Deploy: npx opennextjs-cloudflare deploy --config wrangler.jlynne.jsonc -- --keep-vars
// Steps and secrets: docs/jlynne-account-move.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jlynne-cms",
  "account_id": "eafd097bc9914edce898c4d47bd6d875",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jlynne-cms",
    },
  ],
  "routes": [
    { "pattern": "transformidable.net", "custom_domain": true },
    // The old library's address, which KADE reads until it moves to
    // transformidable.net.
    { "pattern": "jlynne.io", "custom_domain": true },
  ],
  "vars": {
    // Where /api/assets/current points people for downloads: the Advisory
    // tools pages. Change to transformidablethinking.com when that domain
    // moves to this Worker.
    "PUBLIC_DOWNLOAD_BASE_URL": "https://transformidable.net/advisory/tools",
  },
  "r2_buckets": [
    {
      // Transformidable media and documents, copied from the Transformidable
      // account's bucket of the same name. Asset files go under asset-files/.
      "binding": "MEDIA_BUCKET",
      "bucket_name": "transformidable-media",
    },
    {
      // The jlynne.io bucket, read by the one-time import only.
      "binding": "JLYNNE_R2",
      "bucket_name": "jlynne-cms",
    },
  ],
  "d1_databases": [
    {
      // The jlynne.io database, read by the one-time import only.
      "binding": "JLYNNE_D1",
      "database_name": "jlynne-cms",
      "database_id": "d14351b1-38d3-4a9d-977e-c3cd86e08827",
    },
  ],
  "hyperdrive": [
    {
      // The J. Lynne account's Hyperdrive, pointing at the same Supabase
      // Session pooler URL as the Transformidable account's.
      "binding": "HYPERDRIVE",
      "id": "ccad495920d74de8933471385e2ba4b6",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // No cron yet: the Transformidable account's Worker sends the daily case
  // digest, and two schedulers would send it twice. Add
  // "triggers": { "crons": ["0 13 * * *"] } here, and remove it there, at cutover.
  "observability": {
    "enabled": true,
  },
}
