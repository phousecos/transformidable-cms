{
  "name": "transformidable-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Payload CMS v3 instance for the Transformidable content ecosystem",
  "scripts": {
    "dev": "next dev",
    "build": "tsx src/migrate.ts && npx payload generate:importmap && next build --webpack",
    "migrate": "tsx src/migrate.ts",
    "start": "next start",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "lint": "next lint",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx src/seed.ts",
    "seed:research": "tsx src/seed/research.ts",
    "seed:articles": "tsx src/seed/articles-to-publications.ts",
    "seed:ucpath": "tsx src/seed/ucpath.ts",
    "import:coding": "tsx src/seed/import-coding.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-cloud-storage": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-r2": "3.91.0",
    "graphql": "^16.8.1",
    "hls.js": "^1.7.3",
    "next": "16.4.2",
    "payload": "3.91.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": "22.x"
  }
}
